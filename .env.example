# Скопируйте в .env и заполните своими значениями.
# Секретный ключ (если пусто — сгенерируется автоматически при запуске)
SECRET_KEY=

# Данные администратора (сотрудника ФОРЭС)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please

# Публичный адрес сайта
SITE_URL=http://127.0.0.1:5000

# Максимальный размер загружаемого файла, байт (15 МБ)
MAX_UPLOAD_SIZE=15728640
